# Godot cache; keep source-side *.uid and *.import files under version control.
/.godot/
/.tools/
/.artifacts/
/build/

# Generated Android templates, Gradle output, and local SDK configuration.
/android/
/native/android/.gradle/
/native/android/build/
/native/android/local.properties
/addons/yandex_ads/bin/

# Local configuration and signing credentials.
.env
.env.*
!.env.example
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx

# Editor and operating system files.
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.tmp
*.bak
